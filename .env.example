DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: sqlite (local) | mysql (production)
DB_ENGINE=sqlite

# MySQL — production дээр DB_ENGINE=mysql тохируулна
MYSQL_DB=easypro
MYSQL_USER=easypro
MYSQL_PASSWORD=easypro
MYSQL_HOST=localhost
MYSQL_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DigitalOcean Spaces (S3). Leave empty to use local MEDIA_ROOT.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=shopo
AWS_LOCATION=easypro
AWS_DEFAULT_ACL=public-read
AWS_S3_ENDPOINT_URL=https://sgp1.digitaloceanspaces.com
AWS_S3_CUSTOM_DOMAIN=shopo.sgp1.cdn.digitaloceanspaces.com
AWS_S3_REGION_NAME=sgp1

# CallPro SMS (OTP)
CALLPRO_SMS_API_URL=https://api-text.callpro.mn/v1/sms/send
CALLPRO_SMS_API_KEY=
CALLPRO_SMS_FROM=72727040
# true үед SMS амжилтгүй байсан ч debug_code буцаана (локал хөгжүүлэлт)
OTP_DEBUG=true
